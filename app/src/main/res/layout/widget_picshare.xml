<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picshare_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_picshare_background"
    android:padding="8dp">

    <AdapterViewFlipper
        android:id="@+id/picshare_widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="6000"
        android:inAnimation="@anim/widget_fade_in"
        android:loopViews="true"
        android:outAnimation="@anim/widget_fade_out" />

    <TextView
        android:id="@+id/picshare_widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/picshare_widget_empty"
        android:textAlignment="center"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/picshare_widget_text_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B314071E"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/picshare_widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/picshare_widget_empty"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/picshare_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Harmony PicShare"
            android:textColor="#FFFF91C6"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
