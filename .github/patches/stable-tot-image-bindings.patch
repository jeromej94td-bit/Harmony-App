+package com.example.data
+
+import android.content.Context
+import com.example.data.model.QuestionPack
+import com.example.ui.components.TotImageProvider
+import java.util.UUID
+
+/**
+ * Keeps the image identity of a "Das oder Das" option independent from its
+ * user-facing label.
+ *
+ * Historically the option text itself was the image key. Renaming that text in
+ * Dev Studio therefore made the image disappear. This store records lightweight
+ * aliases from the editable/display key to the original image key and restores
+ * them on app startup.
+ */
+object StableTotImageBindings {
+    private const val PREFS_NAME = "stable_tot_image_aliases"
+    private const val ALIAS_PREFIX = "alias::"
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    /** Restore persisted aliases before packs are exposed to the UI. */
+    fun install(context: Context) {
+        prefs(context).all.forEach { (rawKey, value) ->
+            if (!rawKey.startsWith(ALIAS_PREFIX) || value !is String) return@forEach
+            val alias = rawKey.removePrefix(ALIAS_PREFIX).trim()
+            val source = value.trim()
+            if (alias.isNotEmpty() && source.isNotEmpty() && !alias.equals(source, ignoreCase = true)) {
+                TotImageProvider.setAlias(alias, source)
+            }
+        }
+    }
+
+    /**
+     * Resolve an editable label/internal key to the original image key.
+     * Alias chains are flattened and bounded so corrupt preferences cannot loop.
+     */
+    fun resolveSource(context: Context, displayOrKey: String): String {
+        var current = displayOrKey.trim()
+        if (current.isEmpty()) return ""
+
+        val seen = LinkedHashSet<String>()
+        repeat(12) {
+            if (!seen.add(current.lowercase())) return current
+            val next = prefs(context).getString(ALIAS_PREFIX + current, null)?.trim().orEmpty()
+            if (next.isEmpty() || next.equals(current, ignoreCase = true)) return current
+            current = next
+        }
+        return current
+    }
+
+    /** Persist a rename without moving, renaming or re-importing the image file. */
+    fun bindAlias(context: Context, aliasKey: String, sourceKey: String) {
+        val alias = aliasKey.trim()
+        val source = resolveSource(context, sourceKey).ifBlank { sourceKey.trim() }
+        if (alias.isEmpty() || source.isEmpty() || alias.equals(source, ignoreCase = true)) return
+
+        prefs(context).edit()
+            .putString(ALIAS_PREFIX + alias, source)
+            .apply()
+        TotImageProvider.setAlias(alias, source)
+    }
+
+    /** Internal image id for a brand-new slot that has no label yet. */
+    fun newAssetKey(): String =
+        "img_asset_" + UUID.randomUUID().toString().replace("-", "")
+
+    /**
+     * Convert what the developer typed into the value stored in the pair.
+     * Empty display names get a hidden stable key, so even two image-only choices
+     * remain distinguishable as answers while no label is rendered on the card.
+     */
+    fun storedKeyForInput(context: Context, input: String, sourceKey: String): String {
+        val typed = input.trim()
+        if (typed.isNotEmpty()) {
+            if (sourceKey.isNotBlank()) bindAlias(context, typed, sourceKey)
+            return typed
+        }
+
+        val source = sourceKey.trim().ifEmpty { newAssetKey() }
+        val hidden = if (source.startsWith("img_", ignoreCase = true)) {
+            source
+        } else {
+            val suffix = Integer.toHexString(source.hashCode())
+            "img_choice_${DevAssetStore.slug(source).take(32)}_$suffix"
+        }
+        bindAlias(context, hidden, source)
+        return hidden
+    }
+
+    /**
+     * Make the final label aliases export-safe. For local/generated file images we
+     * additionally mirror the final key to the same path. The canonical image file
+     * stays unchanged; only its lookup key is projected for legacy/export code.
+     */
+    fun materializeAliasesForPack(context: Context, pack: QuestionPack) {
+        val keys = buildList {
+            pack.pairs.forEach { (first, second) ->
+                if (first.isNotBlank()) add(first.trim())
+                if (second.isNotBlank()) add(second.trim())
+            }
+        }.distinct()
+
+        keys.forEach { key ->
+            val source = resolveSource(context, key)
+            if (source.isBlank() || source.equals(key, ignoreCase = true)) return@forEach
+
+            TotImageProvider.setAlias(key, source)
+            val path = DeveloperDataManager.imagePathFor(source)
+            if (!path.isNullOrBlank()) {
+                DeveloperDataManager.setImageOverride(context, key, path)
+            }
+        }
+    }
+}
