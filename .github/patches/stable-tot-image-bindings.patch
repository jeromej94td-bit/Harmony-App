+package com.example.data
+
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import com.example.ui.components.TotImageProvider
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [36])
+class StableTotImageBindingsTest {
+
+    @Test
+    fun renamedAndHiddenLabelsKeepOriginalImage() {
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        context.getSharedPreferences("stable_tot_image_aliases", Context.MODE_PRIVATE)
+            .edit()
+            .clear()
+            .commit()
+
+        val source = "stable-test-original"
+        val renamed = "Mein neuer frei gewählter Name"
+        val image = "https://example.com/stable-test-image.jpg"
+
+        TotImageProvider.setCustomImage(source, image)
+
+        StableTotImageBindings.bindAlias(context, renamed, source)
+        assertEquals(image, TotImageProvider.getImageUrl(renamed))
+
+        val hidden = StableTotImageBindings.storedKeyForInput(
+            context = context,
+            input = "",
+            sourceKey = source
+        )
+        assertFalse(DevAssetStore.isUserFacingLabel(hidden))
+        assertEquals(image, TotImageProvider.getImageUrl(hidden))
+
+        // Simulate a process restart restoring aliases from SharedPreferences.
+        StableTotImageBindings.install(context)
+        assertEquals(image, TotImageProvider.getImageUrl(renamed))
+        assertEquals(image, TotImageProvider.getImageUrl(hidden))
+
+        TotImageProvider.removeCustomImage(source)
+    }
+}
